<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Requis pour les connexions WebSocket/HTTPS vers Twitch (IRC + Helix). -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Requis pour le serveur local de l'overlay (Browser Source OBS). -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- Accès en lecture/écriture au dossier de données applicatif (config,
         base SQLite, voix Piper téléchargées). -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
